# ---------------------------------------------------------------------------
# MR PRINT WORLD - PRINT DATA SaaS : server environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Public origin of the React client (used for CORS + links inside notifications)
CLIENT_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Local development only. In production this MUST be your real connection
# string ending in a database name - a URI with no database name silently
# resolves to "test", which on a shared cluster is someone else's live data.
MONGO_URI=mongodb://127.0.0.1:27017/mrpw_printdata

# --- Auth -------------------------------------------------------------------
# Generate strong unique values, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# --- Storage ----------------------------------------------------------------
# STORAGE_DRIVER = cloudinary | local
STORAGE_DRIVER=local
UPLOAD_MAX_MB=8

# Required when STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mrpw-printdata

# --- Bootstrap the first MR Print World super admin -------------------------
# Used ONLY by `npm run bootstrap`. Remove these values afterwards.
SUPER_ADMIN_NAME=MR Print World Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Rate limiting ----------------------------------------------------------
# Email. `log` writes messages to the server log instead of sending them,
# so password resets and notifications work before SMTP exists.
MAIL_DRIVER=log
MAIL_FROM=MR Print World <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10
