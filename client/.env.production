# Loaded automatically by Vite for production builds (`vite build`).
#
# Committed on purpose: this is a public URL, not a secret, and keeping it in
# the repo means a deploy cannot silently fall back to "/api" because a
# dashboard variable was scoped to the wrong environment. A value set in
# Vercel's dashboard still overrides this file if one is ever needed.
#
# Must stay same-site with the frontend (id./ids. share mrprintworld.com), so
# the refresh cookie is first-party and Safari does not drop the session.
VITE_API_URL=https://ids.mrprintworld.com/api
